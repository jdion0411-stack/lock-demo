{
  "name": "lock-demo",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "EOTA_API",
        "class_name": "EotaApi"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "EotaApi"
      ]
    }
  ],
  "vars": {
    "ANALYTICS_ENABLED": "true"
  }
}
